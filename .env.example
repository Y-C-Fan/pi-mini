# pi-mini 配置示例。复制成 .env 后填值。
# 优先级：CLI 参数 > .env > ~/.pi-mini/config.json

# OpenAI 兼容端点，必须支持流式（stream: true）。
PI_MINI_BASE_URL=https://api.openai.com/v1

# 对应端点的 key。不要提交真值，.env 已在 .gitignore。
PI_MINI_API_KEY=

# 模型名。该模型必须同时支持两件事，缺一件 pi-mini 就跑不起来：
# 1. 流式返回 delta.content
# 2. 流式返回 delta.tool_calls（分片形式，arguments 是字符串碎片）
PI_MINI_MODEL=gpt-4o-mini

# 上下文窗口，压缩阈值按它减去 16384 预留算。
PI_MINI_CONTEXT_WINDOW=128000

# 自检方法：发一次带 tools 的流式请求，看返回里有没有 delta.tool_calls，
# 且 finish_reason 最终为 tool_calls。请求体用仓库里的样例：
#
#   curl -N -s "$PI_MINI_BASE_URL/chat/completions" \
#     -H 'Content-Type: application/json' \
#     -H "Authorization: Bearer $PI_MINI_API_KEY" \
#     --data-binary @tests/fixtures/req-tool.json
#
# 没有 tool_calls 流出，说明端点或模型不支持工具调用，换模型或换网关。
# 只有非流式响应（一次性返回 JSON），说明端点没开 stream，不能用于 pi-mini。
